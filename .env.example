# PICSEAL 环境变量模板 —— 复制为 .env / .env.r2 按需填写（均已 gitignore）

# ── 媒体 CDN（Cloudflare R2） ──────────────────────────────
# 构建期注入：设置后所有演示媒体（样片/放映室影音/水印字体/logo/GLB/BGM）
# 改写为该域下的绝对 URL；不设置 = 使用应用自身 public/（本地兜底）。
# Vercel：项目 Settings → Environment Variables 加同名变量后 redeploy。
NEXT_PUBLIC_MEDIA_BASE=https://media.zhiweio.me

# ── pnpm sync:media 所需（写入 .env.r2，不要提交） ──────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=1a2be850ec8c4b3d5ea917c9636b7d72
R2_BUCKET=picseal-media
